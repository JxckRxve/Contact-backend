PORT=10000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=902102344
CORS_ORIGIN=*
MESSAGE_LIMIT_PER_HOUR=30

# CONTACT AI Gateway — every provider below is optional.
# Endpoint should be an OpenAI-compatible chat-completions URL.
CONTACT_AI_PRIMARY_ENDPOINT=
CONTACT_AI_PRIMARY_API_KEY=
CONTACT_AI_PRIMARY_MODEL=
CONTACT_AI_PRIMARY_KIND=openai-compatible

CONTACT_AI_SECONDARY_ENDPOINT=
CONTACT_AI_SECONDARY_API_KEY=
CONTACT_AI_SECONDARY_MODEL=
CONTACT_AI_SECONDARY_KIND=openai-compatible

# Self-hosted/local endpoint can omit API key.
CONTACT_AI_LOCAL_ENDPOINT=
CONTACT_AI_LOCAL_API_KEY=
CONTACT_AI_LOCAL_MODEL=
CONTACT_AI_LOCAL_KIND=local-openai-compatible

# Legacy PERSONA vars still supported as fallback by migration if needed.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
