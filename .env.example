PORT=10000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=902102344
CORS_ORIGIN=*
MESSAGE_LIMIT_PER_HOUR=30

# G-OS / CONTACT AI Gateway — every provider is swappable.
# Recommended OpenAI primary for the current Core:
# CONTACT_AI_PRIMARY_ENDPOINT=https://api.openai.com/v1/responses
# CONTACT_AI_PRIMARY_API_KEY=RENDER_SECRET_ONLY
# CONTACT_AI_PRIMARY_MODEL=gpt-5.6-luna
# CONTACT_AI_PRIMARY_KIND=openai-responses
CONTACT_AI_PRIMARY_ENDPOINT=
CONTACT_AI_PRIMARY_API_KEY=
CONTACT_AI_PRIMARY_MODEL=
CONTACT_AI_PRIMARY_KIND=openai-compatible

# Generic OpenAI-compatible chat-completions provider.
CONTACT_AI_SECONDARY_ENDPOINT=
CONTACT_AI_SECONDARY_API_KEY=
CONTACT_AI_SECONDARY_MODEL=
CONTACT_AI_SECONDARY_KIND=openai-compatible

# Self-hosted/local endpoint can omit API key.
CONTACT_AI_LOCAL_ENDPOINT=
CONTACT_AI_LOCAL_API_KEY=
CONTACT_AI_LOCAL_MODEL=
CONTACT_AI_LOCAL_KIND=local-openai-compatible

# Legacy PERSONA variables remain supported as a primary-provider fallback.
# LLM_KIND may be `openai-compatible` or `openai-responses`.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_KIND=
